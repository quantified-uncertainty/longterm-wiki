#!/usr/bin/env bash
#
# Pre-push hook — runs CI-blocking checks before allowing push.
# Activate with: git config core.hooksPath .githooks
#
# To bypass (emergencies only): git push --no-verify
#

set -euo pipefail

# ── Check for pushes to branches with already-merged PRs ──
# Prevents orphaned commits when an agent pushes after merge.
BRANCH=$(git branch --show-current 2>/dev/null || true)
if [ -n "$BRANCH" ] && [ "$BRANCH" != "main" ] && command -v gh &>/dev/null; then
  PR_STATE=$(gh pr view "$BRANCH" --json state --jq '.state' 2>/dev/null || true)
  if [ "$PR_STATE" = "MERGED" ]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  BLOCKED: PR for branch '$BRANCH' is already MERGED.       ║"
    echo "║                                                            ║"
    echo "║  These commits will be orphaned — they won't reach main.   ║"
    echo "║  Create a new branch and cherry-pick your commits instead. ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
  fi
  if [ "$PR_STATE" = "CLOSED" ]; then
    echo ""
    echo "⚠  WARNING: PR for branch '$BRANCH' is CLOSED."
    echo "   Commits pushed here won't reach main unless a new PR is opened."
    echo ""
  fi
fi

echo ""
echo "Running pre-push gate checks..."
echo ""

GATE_EXIT=0
pnpm crux w validate gate || GATE_EXIT=$?

if [ "$GATE_EXIT" -ne 0 ]; then
  # Gate failed. Check if main CI is also red — if so, the failure is likely
  # pre-existing and not caused by this branch's changes.
  echo ""
  echo "Gate check failed. Checking if main branch CI is also broken..."
  MAIN_STATUS=$(gh api "repos/quantified-uncertainty/longterm-wiki/actions/workflows/ci.yml/runs?branch=main&status=completed&per_page=1" --jq '.workflow_runs[0].conclusion' 2>/dev/null || echo "unknown")

  if [ "$MAIN_STATUS" = "failure" ]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  ⚠ Gate failed, but main CI is ALSO RED (pre-existing).    ║"
    echo "║  Allowing push — the failure is likely not from your code.  ║"
    echo "║  Main needs to be fixed separately.                        ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""
    # Fall through — allow push
  else
    echo ""
    echo "Main CI is green — this failure is from your changes."
    exit "$GATE_EXIT"
  fi
fi

# After gate passes (or is excused), run agent checklist auto-verify.
# Blocks push if checklist exists but is <40% complete (session skipped workflow).
echo ""
pnpm crux sys agent-checklist pre-push-check
