# ---- Stage 1: Install only worker dependencies ----
FROM node:22-alpine AS deps
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /deps
COPY docker/worker/package.json ./
RUN pnpm install --prod

# ---- Stage 2: Runtime image ----
FROM node:22-alpine
WORKDIR /repo

# Copy only the deps we need (~30MB vs ~1GB full monorepo)
COPY --from=deps /deps/node_modules ./node_modules

# Install tsx globally (needed for TypeScript compilation at runtime)
RUN npm install -g tsx@4.19.0

# Copy crux source (worker + all transitive imports)
COPY crux/ ./crux/

# NOTE: No apps/wiki-server/ files needed — all imports are type-only (erased by tsx)
# NOTE: No content/, data/, apps/web/ needed — worker is stateless

ENV NODE_ENV=production

# Non-root user for security
RUN addgroup -S worker && adduser -S worker -G worker
USER worker

# Health endpoint port
EXPOSE 3101

CMD ["node", "--import", "tsx/esm", "crux/worker/run.ts", \
     "--poll", "--poll-interval=5000", "--verbose"]
