# ---- Stage 1: Install only worker dependencies ----
FROM node:20-slim AS deps
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /deps
# Workspace packages referenced as file:./packages/<pkg> from docker/worker/package.json
# must be present before `pnpm install` resolves them. Without this, the install
# succeeds but @longterm-wiki/* imports from crux hit ERR_MODULE_NOT_FOUND at
# runtime (QUA-605; same class as QUA-598).
#
# Copy only the packages actually declared as file: deps in worker/package.json —
# broad `COPY packages/ ./packages/` would also pull in packages/factbase/data/*.yaml
# (2+ MB of content that churns on every factbase sync), invalidating the
# `pnpm install --prod` layer cache on unrelated FactBase edits. Add a line below
# for each @longterm-wiki/* dep added to docker/worker/package.json.
COPY packages/url-utils/ ./packages/url-utils/
COPY docker/worker/package.json ./
RUN pnpm install --prod

# ---- Stage 2: Runtime image ----
# Node 20 required: tsx's ESM loader hits ERR_REQUIRE_CYCLE_MODULE on Node 22
# due to its require(esm) cycle detection. Track tsx Node 22 support for upgrade.
# Uses node:20-slim (Debian) instead of Alpine for Playwright/Chromium compatibility.
FROM node:20-slim
WORKDIR /repo

# Install Chromium system dependencies for Playwright.
# Uses Debian's chromium package rather than Playwright's bundled download
# to keep the image smaller and avoid version drift.
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    fonts-liberation \
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libxkbcommon0 \
    libgbm1 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Tell Playwright to use system Chromium instead of downloading its own
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Minimal package.json with "type": "module" so Node treats .ts files as ESM.
# Without this, Node defaults to CJS and tsx's ESM hooks don't apply.
RUN echo '{"type":"module"}' > package.json

# Copy only the deps we need
COPY --from=deps /deps/node_modules ./node_modules

# Verify tsx can load .ts files (catches missing deps or ESM config issues)
RUN echo 'export const X = 1;' > /tmp/test.ts && \
    node --import tsx/esm -e "import('/tmp/test.ts').then(m => { if (m.X !== 1) throw new Error('bad'); console.log('tsx verified'); })"

# Copy crux source (worker + all transitive imports)
COPY crux/ ./crux/

# Keep packages/ available for crux scripts that read packages/factbase/data/*.yaml
# by filesystem path (separate from workspace package resolution, which is handled
# via node_modules above).
COPY packages/ ./packages/

# NOTE: No apps/wiki-server/ files needed — all imports are type-only (erased by tsx)
# NOTE: No content/, data/, apps/web/ needed — worker is stateless
# NOTE: Only stateless handlers (claim-verification, ping) work in this image.
# citation-verify shells out to crux CLI (needs full monorepo deps).
# page-improve/page-create/batch-commit need git. Both stay on GHA.

ENV NODE_ENV=production

# Non-root user for security (use standard Debian adduser)
RUN groupadd -r worker && useradd -r -g worker worker
USER worker

# Health endpoint port
EXPOSE 3101

CMD ["node", "--import", "tsx/esm", "crux/worker/run.ts", \
     "--poll", "--poll-interval=5000", "--verbose"]
