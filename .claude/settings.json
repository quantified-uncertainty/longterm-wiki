{
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Grep(*)",
      "Glob(*)",
      "Agent(*)",
      "WebFetch",
      "WebSearch",
      "mcp__serena__*",
      "mcp__plugin_playwright_playwright__*",
      "mcp__plugin_drywall_jscpd__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "statusMessage": "Setting up environment..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [

        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
        ]
      }
    ]
  }
}
