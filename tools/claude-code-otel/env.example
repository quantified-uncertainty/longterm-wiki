# Claude Code OpenTelemetry — env vars to enable cost/usage telemetry.
#
# Copy these into ~/.claude/.env, lw/.env.base, or your shell rc
# (whichever your Claude Code instance reads), then start the docker
# stack with: docker-compose up -d
#
# Telemetry stays local — the OTLP collector listens on
# 127.0.0.1:4318 by default.

# Master switch (must be 1 — anything else, telemetry stays off)
CLAUDE_CODE_ENABLE_TELEMETRY=1

# Send to local OTel collector via HTTP. The collector forwards to
# Prometheus, which Grafana reads at http://localhost:3000.
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Flush metrics every 60s (default 60000ms is fine; set lower for
# faster feedback during initial tuning).
OTEL_METRIC_EXPORT_INTERVAL=60000

# Note: hostname / username are added automatically by the OTel
# Collector's `resourcedetection` processor — see
# tools/claude-code-otel/otel-collector/config.yaml. Don't set them
# here with `$(hostname)` syntax; .env files do not expand subshells.
