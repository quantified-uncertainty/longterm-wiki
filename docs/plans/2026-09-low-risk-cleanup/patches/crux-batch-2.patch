-const CONCURRENCY = 10;
-const MAX_RETRIES = 3;
-
-// ---------------------------------------------------------------------------
-// Rule-based heuristics
-// ---------------------------------------------------------------------------
-
-/**
- * Subcategory-based defaults. These provide a starting point.
- * "null" means "use Haiku to decide."
- */
-const SUBCATEGORY_DEFAULTS: Record<string, number> = {
