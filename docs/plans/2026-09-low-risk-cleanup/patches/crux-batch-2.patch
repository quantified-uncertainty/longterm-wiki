-
-  // Apply fixes
-  console.log("\nApplying fixes to wiki-server...\n");
-  let success = 0;
-  let errors = 0;
-
-  for (const fix of fixes) {
-    try {
-      const ok = await applyFix(fix);
-      if (ok) {
-        console.log(`  OK: ${fix.id} -> "${fix.newTitle}"`);
-        success++;
-      } else {
