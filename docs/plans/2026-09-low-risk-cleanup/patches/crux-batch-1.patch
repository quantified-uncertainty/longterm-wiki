-  return lines.join('\n');
-}
-
-// ---------------------------------------------------------------------------
-// Internal formatting
-// ---------------------------------------------------------------------------
-
-function formatDelta(delta: number): string {
-  if (delta === 0) return '\x1b[2m0\x1b[0m';
-  const sign = delta > 0 ? '+' : '';
-  const color = delta > 0 ? '\x1b[32m' : '\x1b[31m';
