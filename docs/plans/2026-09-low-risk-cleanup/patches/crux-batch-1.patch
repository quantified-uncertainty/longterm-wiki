-    (a, b) => b.aggregateScore - a.aggregateScore,
-  );
-
-  for (const row of sorted) {
-    const tierBadge =
-      row.tier === "sub-entity"
-        ? `${SCORE_COLORS.dim} [sub-entity]${SCORE_COLORS.reset}`
