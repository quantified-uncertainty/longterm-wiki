{
  "_comment": "Codex agent hooks — point at the canonical .claude/hooks/*.sh scripts so Claude Code and Codex stay in sync. The hook scripts themselves are agent-neutral (CODEX_PROJECT_DIR is preferred, CLAUDE_PROJECT_DIR is the fallback).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash '.claude/hooks/approve-claude-configs.sh'"
          },
          {
            "type": "command",
            "command": "bash '.claude/hooks/require-checklist.sh'"
          },
          {
            "type": "command",
            "command": "bash '.claude/hooks/warn-main-branch.sh'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '.claude/hooks/block-git-stash.sh'"
          },
          {
            "type": "command",
            "command": "bash '.claude/hooks/block-branch-switch.sh'"
          },
          {
            "type": "command",
            "command": "bash '.claude/hooks/block-no-verify.sh'"
          },
          {
            "type": "command",
            "command": "bash '.claude/hooks/block-tmux-kill.sh'"
          },
          {
            "type": "command",
            "command": "bash '.claude/hooks/block-other-slots.sh'"
          },
          {
            "type": "command",
            "command": "bash '.claude/hooks/block-raw-gh-pr.sh'"
          },
          {
            "type": "command",
            "command": "bash '.claude/hooks/require-stage-approved.sh'",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash '.claude/hooks/recover-cwd.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash '.claude/hooks/session-start.sh'",
            "statusMessage": "Setting up environment..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '.claude/hooks/inject-wip-checklist.sh'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '.claude/hooks/verify-checklist-on-stop.sh'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
