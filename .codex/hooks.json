{
  "_comment": "Codex agent hooks — point at the canonical .claude/hooks/*.sh scripts so Claude Code and Codex stay in sync. Paths use ${CODEX_PROJECT_DIR:-$PWD} so the hook still resolves if the agent's CWD has drifted (mirrors .claude/settings.json's $CLAUDE_PROJECT_DIR pattern). The hook scripts themselves are agent-neutral (CODEX_PROJECT_DIR is preferred, CLAUDE_PROJECT_DIR is the fallback).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-$PWD}/.claude/hooks/approve-claude-configs.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-$PWD}/.claude/hooks/warn-main-branch.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-$PWD}/.claude/hooks/block-no-verify.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-$PWD}/.claude/hooks/recover-cwd.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
