{
  "name": "longterm-wiki",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DEV_PORT=$(grep -m1 '^DEV_PORT=' .env 2>/dev/null | cut -d= -f2-) pnpm --filter longterm-next dev",
    "build": "pnpm --filter longterm-next build",
    "test": "pnpm --filter longterm-next test && pnpm --filter discord-bot test && pnpm --filter wiki-server test && vitest run --config crux/vitest.config.ts",
    "test:crux": "vitest run --config crux/vitest.config.ts",
    "test:coverage": "pnpm --filter longterm-next exec vitest run --coverage && pnpm --filter discord-bot exec vitest run --coverage && pnpm --filter wiki-server exec vitest run --coverage && npx vitest run --config crux/vitest.config.ts --coverage && npx tsx crux/ci/merge-coverage.ts",
    "build-data:content": "pnpm --filter longterm-next run sync:data:content",
    "build-data:quick": "pnpm --filter longterm-next run sync:data:content",
    "lint": "NODE_OPTIONS='--max-old-space-size=8192' eslint --max-warnings=0 .",
    "validate": "DOTENV_CONFIG_QUIET=true NODE_USE_ENV_PROXY=1 node crux/run.mjs validate",
    "crux": "DOTENV_CONFIG_QUIET=true NODE_USE_ENV_PROXY=1 node crux/run.mjs",
    "crux:tsx": "DOTENV_CONFIG_QUIET=true NODE_USE_ENV_PROXY=1 node --import tsx/esm crux/crux.mjs",
    "crux:build": "node crux/build.mjs",
    "crux:watch": "node crux/build.mjs --watch",
    "setup": "bash scripts/setup.sh",
    "setup:quick": "bash scripts/setup.sh --quick",
    "setup:check": "bash scripts/setup.sh --check",
    "postinstall": "if [ -f crux/build.mjs ]; then node crux/build.mjs; fi",
    "prepare": "git config core.hooksPath .githooks || true; git config merge.drizzle-journal.driver 'node crux/git/drizzle-journal-merge.mjs %O %A %B %P' || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@aws-sdk/client-s3": "^3.1013.0",
    "@longterm-wiki/url-utils": "workspace:*",
    "@radix-ui/react-popover": "^1.1.15",
    "dotenv": "^17.2.4",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "pdf-parse": "^2.4.5",
    "yaml": "^2.7.0",
    "youtube-transcript": "^1.2.1",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@mendable/firecrawl-js": "^1.15.5"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "4.0.18",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hono": "^4.12.4",
    "playwright": "^1.50.0",
    "proper-lockfile": "^4.1.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.0",
    "remark-mdx-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "tinyglobby": "^0.2.16",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "unified": "^11.0.5",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "rollup": ">=4.59.0",
      "dompurify": ">=3.3.2",
      "immutable": ">=4.3.8"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
